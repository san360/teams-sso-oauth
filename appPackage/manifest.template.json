{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "manifestVersion": "1.24",
  "version": "{{VERSION}}",
  "id": "{{TEAMS_APP_ID}}",
  "name": { "short": "SSO Test Agent", "full": "Teams and Copilot SSO test agent" },
  "developer": {
    "name": "SSO Test",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/terms"
  },
  "description": {
    "short": "Echo agent with a whoami command for testing SSO",
    "full": "Echoes messages without sign-in. The whoami command signs the user in through Bot SSO (signin/tokenExchange) and shows non-identifying sign-in status."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#4F6BED",
  "bots": [
    {
      "botId": "{{BOT_ID}}",
      "scopes": ["copilot", "personal"],
      "commandLists": [
        {
          "scopes": ["copilot", "personal"],
          "commands": [
            { "title": "whoami", "description": "Sign in with SSO and show sign-in status" },
            { "title": "logout", "description": "Clear the cached token" }
          ]
        }
      ],
      "isNotificationOnly": false,
      "supportsFiles": false
    }
  ],
  "copilotAgents": {
    "customEngineAgents": [ { "type": "bot", "id": "{{BOT_ID}}" } ]
  },
  "validDomains": ["token.botframework.com"],
  "webApplicationInfo": {
    "id": "{{SSO_APP_ID}}",
    "resource": "{{SSO_RESOURCE}}"
  }
}
